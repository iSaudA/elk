STACK_VERSION=8.19.21

# These three values are filled by Terraform on Azure.
ELASTIC_PASSWORD=change-me
KIBANA_PASSWORD=change-me
LOGSTASH_PASSWORD=change-me
LOG_INGEST_TOKEN=change-me

# Terraform supplies the real hostname. Placeholder for configuration checks only.
KIBANA_HOSTNAME=example.eastus.cloudapp.azure.com

# Optional reporting branch. Terraform supplies real values when enabled.
ANALYTICS_EXPORT_ENABLED=false
ANALYTICS_INGEST_URL=http://127.0.0.1/disabled
ANALYTICS_INGEST_TOKEN=disabled
